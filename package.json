{
  "name": "examples-js-vanilla",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "author": "A.suzuki <suzu.devworks@gmail.com>",
  "description": "Workspace for studying javascript programming.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/suzu-devworks/examples-js-vanilla.git"
  },
  "workspaces": ["packages/**"],
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "postinstall": "simple-git-hooks",
    "lint": "biome check .",
    "format": "biome format ."
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "lint-staged": {
    "packages/**/*": ["pnpm run format --write"],
    "packages/**/*.{js,mjs,cjs,ts,mts,cts,css,scss}": ["pnpm run lint --write"]
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^2.1.1",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "lint-staged": "^17.6.0",
    "prettier": "3.9.10",
    "simple-git-hooks": "^2.14.0",
    "stylelint": "^17.16.0",
    "stylelint-config-recess-order": "^7.9.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "typescript-eslint": "^8.72.1"
  },
  "packageManager": "pnpm@12.16.1"
}
