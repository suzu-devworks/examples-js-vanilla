{
  "name": "examples-js-vanilla",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "author": "A.suzuki <suzu.devworks@gmail.com>",
  "description": "Workspace for studying javascript programming.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/suzu-devworks/examples-js-vanilla.git"
  },
  "workspaces": ["packages/**"],
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "postinstall": "simple-git-hooks",
    "lint": "biome check .",
    "format": "biome format ."
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "lint-staged": {
    "packages/**/*": ["pnpm run format --write"],
    "packages/**/*.{js,mjs,cjs,ts,mts,cts,css,scss}": ["pnpm run lint --write"]
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "lint-staged": "^17.6.0",
    "simple-git-hooks": "^2.14.0"
  },
  "packageManager": "pnpm@12.16.1"
}
