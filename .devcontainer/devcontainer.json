{
  "name": "TypeScript (Node.js)",
  "dockerComposeFile": [
    "compose.dev.yaml"
  ],
  "service": "dev",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  "mounts": [
    "source=node_modules,target=${containerWorkspaceFolder}/node_modules,type=volume",
    "source=${localEnv:HOME}/.copilot/instructions,target=/home/vscode/.copilot/instructions,type=bind,consistency=cached",
    "source=${localEnv:HOME}/.copilot/skills,target=/home/vscode/.copilot/skills,type=bind,consistency=cached"
  ],
  "postCreateCommand": "/bin/sh ./.devcontainer/postCreateCommand.sh",
  "containerEnv": {
    "pnpm_config_store_dir": "${containerWorkspaceFolder}/.pnpm-store"
  },
  "remoteUser": "vscode",
  "features": {
    "ghcr.io/devcontainers/features/copilot-cli:1": {},
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/devcontainers/features/node:2": {
      "nodeGypDependencies": true,
      "version": "26",
      "pnpmVersion": "none",
      "nvmVersion": "latest"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "EditorConfig.EditorConfig",
        "streetsidesoftware.code-spell-checker",
        "DavidAnson.vscode-markdownlint",
        "christian-kohler.npm-intellisense",
        "-dbaeumer.vscode-eslint",
        "biomejs.biome",
        "DotJoshJohnson.xml",
        "jock.svg"
      ]
    }
  }
}
